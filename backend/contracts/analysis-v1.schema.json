{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "commitSha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "fileCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "analysisKind": {
      "enum": [
        "static",
        "ai"
      ]
    },
    "analysisVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "maxItems": 100
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      },
      "minItems": 0,
      "maxItems": 100
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "content": {
            "type": "string",
            "minLength": 0,
            "maxLength": 40000
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 8
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 0,
            "maxLength": 12000
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "minItems": 0,
            "maxItems": 8
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "description",
          "files"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "kind": {
            "const": "imports"
          }
        },
        "required": [
          "from",
          "to",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "startLine": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40000
                },
                "endLine": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40000
                }
              },
              "required": [
                "path",
                "startLine",
                "endLine"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 16
          }
        },
        "required": [
          "title",
          "body",
          "nodeId",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "summary",
    "commitSha",
    "branch",
    "fileCount",
    "analysisKind",
    "analysisVersion",
    "model",
    "generatedAt",
    "technologies",
    "warnings",
    "files",
    "nodes",
    "edges",
    "steps"
  ],
  "additionalProperties": false
}
